desc: HarmonicaScope
author: OracPrime + Gemini
version: 2.7

slider1:0<0,1,1{C Diatonic,A Diatonic}> Harmonica Key
slider2:1<0,1,1{Automatic AGC,Manual Slider}> Sensitivity Mode
slider3:-40<-60,-6,1> Manual Threshold (dB)
slider4:0<0,12,1{None,C,C#,D,Eb,E,F,F#,G,Ab,A,Bb,B}> Scale Root
slider5:0<0,3,1{Major,Natural Minor,Blues,Major Pentatonic}> Scale Type

@init
MAX_HOLES = 10;
PI = 3.14159265358979323846;

// Memory layout offsets - LOCKED backend
freq_blow = 0;      freq_draw = 10;     
g_coef_b  = 20;     g_coef_d  = 30;     
s1_b = 40; s2_b = 50;  s1_d = 60; s2_d = 70;
mag_b = 80; mag_d = 90;
note_b = 100; note_d = 110;

running_peak = 0.005;
noise_floor = 0.001;

block_size = srate > 88200 ? 2048 : 1024; 
sample_count = 0;

function init_frequencies()
(
  memset(s1_b, 0, 10); memset(s2_b, 0, 10);
  memset(s1_d, 0, 10); memset(s2_d, 0, 10);

  slider1 == 0 ? (
    note_b[0] = 60; note_d[0] = 62;
    note_b[1] = 64; note_d[1] = 67;
    note_b[2] = 67; note_d[2] = 71;
    note_b[3] = 72; note_d[3] = 74;
    note_b[4] = 76; note_d[4] = 77;
    note_b[5] = 79; note_d[5] = 81;
    note_b[6] = 84; note_d[6] = 83;
    note_b[7] = 88; note_d[7] = 86;
    note_b[8] = 91; note_d[8] = 89;
    note_b[9] = 96; note_d[9] = 93;
  ) : (
    note_b[0] = 57; note_d[0] = 59;
    note_b[1] = 61; note_d[1] = 64;
    note_b[2] = 64; note_d[2] = 68;
    note_b[3] = 69; note_d[3] = 71;
    note_b[4] = 73; note_d[4] = 74;
    note_b[5] = 76; note_d[5] = 80;
    note_b[6] = 81; note_d[6] = 79;
    note_b[7] = 85; note_d[7] = 83;
    note_b[8] = 88; note_d[8] = 86;
    note_b[9] = 93; note_d[9] = 89;
  );

  i = 0;
  loop(MAX_HOLES,
    freq_blow[i] = 440.0 * pow(2.0, (note_b[i] - 69.0) / 12.0);
    freq_draw[i] = 440.0 * pow(2.0, (note_d[i] - 69.0) / 12.0);
    g_coef_b[i] = 2.0 * cos(2.0 * PI * freq_blow[i] / srate);
    g_coef_d[i] = 2.0 * cos(2.0 * PI * freq_draw[i] / srate);
    i += 1;
  );
);

function check_scale_match(midi_note)
local(root_pc, note_pc, interval, mask, is_match)
(
  is_match = 0;
  slider4 > 0 ? (
    root_pc = slider4 - 1; 
    note_pc = midi_note % 12;
    interval = (note_pc - root_pc + 12) % 12;
    
    mask = 0;
    slider5 == 0 ? mask = 2741; 
    slider5 == 1 ? mask = 2773; 
    slider5 == 2 ? mask = 1171; 
    slider5 == 3 ? mask = 2709; 
    
    is_match = (mask >> interval) & 1;
  );
  is_match;
);

init_frequencies();
last_key = slider1;

@slider
last_key != slider1 ? ( init_frequencies(); last_key = slider1; );

@sample
input_sample = (spl0 + spl1) * 0.5;
i = 0;
loop(MAX_HOLES,
  s0_b = input_sample + g_coef_b[i] * s1_b[i] - s2_b[i]; s2_b[i] = s1_b[i]; s1_b[i] = s0_b;
  s0_d = input_sample + g_coef_d[i] * s1_d[i] - s2_d[i]; s2_d[i] = s1_d[i]; s1_d[i] = s0_d;
  i += 1;
);

sample_count += 1;
sample_count >= block_size ? (
  max_peak = 0.0;
  norm_factor = 2.0 / block_size;

  i = 0;
  loop(MAX_HOLES,
    mag_b[i] = norm_factor * sqrt(max(0, s1_b[i]*s1_b[i] + s2_b[i]*s2_b[i] - g_coef_b[i]*s1_b[i]*s2_b[i]));
    mag_d[i] = norm_factor * sqrt(max(0, s1_d[i]*s1_d[i] + s2_d[i]*s2_d[i] - g_coef_d[i]*s1_d[i]*s2_d[i]));
    
    max_peak = max(max_peak, max(mag_b[i], mag_d[i]));

    s1_b[i] = 0; s2_b[i] = 0; s1_d[i] = 0; s2_d[i] = 0;
    i += 1;
  );

  mag_b[7] > 0.0 ? ( mag_b[4] > (mag_b[7] * 1.5) ? mag_b[7] = 0; );
  mag_b[6] > 0.0 ? ( mag_b[3] > (mag_b[6] * 1.5) ? mag_b[6] = 0; );
  mag_b[8] > 0.0 ? ( mag_b[5] > (mag_b[8] * 1.5) ? mag_b[8] = 0; );

  slider2 == 0 ? (
    max_peak > running_peak ? (
      running_peak += (max_peak - running_peak) * 0.5; 
    ) : (
      running_peak -= (running_peak - max_peak) * 0.1; 
    );
    running_peak = max(running_peak, noise_floor);
    thresh_amp = running_peak * 0.25;
  ) : (
    thresh_amp = pow(10, slider3 / 20);
  );

  sample_count = 0;
);

@gfx 660 250
gfx_clear = 2105376;

function get_note_name(midi_num)
(
  pc = midi_num % 12;
  pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "Eb" :
  pc == 4 ? "E" : pc == 5 ? "F" : pc == 6 ? "F#" : pc == 7 ? "G" :
  pc == 8 ? "Ab" : pc == 9 ? "A" : pc == 10 ? "Bb" : "B";
);

box_w = 56; box_h = 66; start_x = 35; start_y = 90;
half_h = box_h / 2;

i = 0;
loop(MAX_HOLES,
  x = start_x + (i * (box_w + 5));
  
  scale_b = check_scale_match(note_b[i]);
  scale_d = check_scale_match(note_d[i]);

  is_blow = (mag_b[i] > thresh_amp);
  is_draw = (mag_d[i] > thresh_amp);

  // --- STATIC TOP OUTSIDE BOX (Scale Map Guide Only) ---
  scale_b ? gfx_set(0.12, 0.32, 0.16, 1) : gfx_set(0.25, 0.25, 0.25, 1); 
  gfx_rect(x, start_y - 30, box_w, 25);
  gfx_set(0.9, 0.9, 0.9, 1); 
  gfx_x = x + (box_w/2) - 6; gfx_y = start_y - 24;
  gfx_drawstr(get_note_name(note_b[i]));

  // --- INTERNAL REAL-TIME DETECTION LAYER (Split Hole) ---
  // Top Half of the hole frame = BLOW activation
  is_blow ? (
    gfx_set(0.2, 0.9, 0.3, 1); // Bright active green
    gfx_rect(x + 1, start_y + 1, box_w - 2, half_h - 1);
  );

  // Bottom Half of the hole frame = DRAW activation
  is_draw ? (
    gfx_set(0.2, 0.9, 0.3, 1); // Bright active green
    gfx_rect(x + 1, start_y + half_h, box_w - 2, half_h - 1);
  );

  // --- PHYSICAL HOLE FRAME OVERLAY ---
  gfx_set(0.5, 0.5, 0.5, 1);
  (is_blow || is_draw) ? gfx_set(1, 0.84, 0, 1); // Golden borders if hole is active
  gfx_rect(x, start_y, box_w, box_h, 0);

  // Split Divider line inside the frame
  gfx_set(0.35, 0.35, 0.35, 1);
  gfx_line(x + 1, start_y + half_h, x + box_w - 2, start_y + half_h);

  // Centered Hole Number text
  gfx_set(0.9, 0.9, 0.9, 1);
  gfx_x = x + (box_w/2) - 5; gfx_y = start_y + half_h - 8;
  gfx_printf("%d", i + 1);

  // --- STATIC BOTTOM OUTSIDE BOX (Scale Map Guide Only) ---
  scale_d ? gfx_set(0.12, 0.32, 0.16, 1) : gfx_set(0.25, 0.25, 0.25, 1);
  gfx_rect(x, start_y + box_h + 5, box_w, 25);
  gfx_set(0.9, 0.9, 0.9, 1);
  gfx_x = x + (box_w/2) - 6; gfx_y = start_y + box_h + 11;
  gfx_drawstr(get_note_name(note_d[i]));

  i += 1;
);

gfx_set(0.6, 0.6, 0.6, 1);
gfx_x = 35; gfx_y = 220;
gfx_drawstr("Outside Boxes: Scale Map Guide | Inside Hole: Top Half = Blow Active, Bottom Half = Draw Active");