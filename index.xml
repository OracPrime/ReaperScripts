    <reapack name="Set block size to 128.lua" type="script" desc="Set block/buffer size to 128 for record, revert to 1024 for mix">
      <version name="0.1" author="OracPrime based in part on souk21 script" time="2026-07-03T12:09:20Z">
        <changelog><![CDATA[initial release]]></changelog>
        <source main="main">https://github.com/OracPrime/ReaperScripts/raw/1700cdf49575a9f9e59f3bad824efea3cb1c1a55/Buffer%20Size%20Buttons/Set%20block%20size%20to%20128.lua</source>
      </version>
      <version name="0.3" author="OracPrime based in part on souk21 script" time="2026-08-11T11:02:49Z">
        <changelog><![CDATA[
- Package the 128 and 1024 actions with a shared helper.
- Take high-PDC FX offline for low-latency monitoring and restore them at 1024.
- Include muted tracks in the PDC scan.
- Use native REAPER PDC queries; SWS is no longer required.
        ]]></changelog>
        <source main="main">https://github.com/OracPrime/ReaperScripts/raw/6759f222b568f1cbc0e5a6f0bb113a49a4e97161/Buffer%20Size%20Buttons/Set%20block%20size%20to%20128.lua</source>
